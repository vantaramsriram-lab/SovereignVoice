# ============================================================================
# SovereignVoice backend configuration
# Copy this file to .env  ->  Copy-Item .env.example .env   (Windows PowerShell)
#                            cp .env.example .env           (macOS / Linux)
# Never commit the real .env file.
# ============================================================================

# ---------------------------------------------------------------------------
# SINGLE SHARED GNANI CREDENTIAL
# ---------------------------------------------------------------------------
# Gnani Prisma (STT) and Gnani Timbre (TTS) both use THIS ONE value.
# It is sent to both providers through the header:  X-API-Key-ID
# Do NOT create separate PRISMA_API_KEY_ID or TIMBRE_API_KEY_ID variables.
API_KEY_ID=

# ---------------------------------------------------------------------------
# Gnani Prisma — speech to text
# ---------------------------------------------------------------------------
PRISMA_API_URL=https://api.vachana.ai/stt/v3
PRISMA_MODEL=prisma-v3.0
PRISMA_LANGUAGE_CODE=indic-auto
PRISMA_TIMEOUT=60

# ---------------------------------------------------------------------------
# Gnani Timbre — text to speech
# Uses the same API_KEY_ID above, sent as X-API-Key-ID
# ---------------------------------------------------------------------------
TIMBRE_API_URL=https://api.vachana.ai/api/v1/tts/inference
TIMBRE_MODEL=timbre-v3.0
TIMBRE_VOICE=Shivani
TIMBRE_LANGUAGE=auto
TIMBRE_SPEED=1.0
TIMBRE_SAMPLE_RATE=48000
TIMBRE_NUM_CHANNELS=1
TIMBRE_SAMPLE_WIDTH=2
TIMBRE_ENCODING=linear_pcm
TIMBRE_CONTAINER=wav
TIMBRE_TIMEOUT=120

# ---------------------------------------------------------------------------
# Groq LLM (OpenAI-compatible chat completions)
# Separate credentials from Gnani. Sent as: Authorization: Bearer <GROQ_API_KEY>
# Get a free key at https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MAX_TOKENS=1600
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT=90
# Keeps Qwen3 <think> reasoning out of the JSON reply. Leave empty to disable.
GROQ_REASONING_FORMAT=hidden

# ---------------------------------------------------------------------------
# HTTP / limits / CORS
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT=90
MAX_AUDIO_BYTES=26214400
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.ogg,.webm,.flac
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173, https://sovereign-voice.vercel.app
LOG_LEVEL=INFO
